<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ doc.title }} - {{ doc.cover[0][1] }}</title>
<style>
{% include "report.css.j2" %}</style>
</head>
<body>
<div class="sheet">
<section class="cover">
<h1>{{ doc.title }}</h1>
<table>
<tbody>
{% for label, value in doc.cover %}
<tr><td class="label">{{ label }}</td><td>{{ value }}</td></tr>
{% endfor %}
</tbody>
</table>
<p class="notice">{{ doc.notice }}</p>
</section>

<nav class="toc" aria-label="{{ toc_title }}">
<h2>{{ toc_title }}</h2>
{% for h in toc %}
<p class="l{{ h.level }}"><a href="#{{ h.anchor }}">{{ h.number }} {{ h.text }}</a></p>
{% endfor %}
</nav>

{% for chapter in chapters %}
<section class="chapter{% if chapter.heading.landscape %} landscape{% endif %}">
<h2 id="{{ chapter.heading.anchor }}"><span class="no">{{ chapter.heading.number }}</span>{{ chapter.heading.text }}</h2>
{% for block in chapter.blocks %}
{% if block.kind == "heading" %}
<h{{ block.level }} id="{{ block.anchor }}"><span class="no">{{ block.number }}</span>{{ block.text }}</h{{ block.level }}>
{% elif block.kind == "para" %}
<p>{{ block.text }}</p>
{% else %}
<table>
{% if block.caption %}
<caption>{{ block.caption }}</caption>
{% endif %}
<colgroup>{% for w in block.widths %}<col style="width: {{ w }}%">{% endfor %}</colgroup>
<thead><tr>{% for h in block.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in block.rows %}
<tr>{% for cell in row %}<td{% if cell.raw %} class="raw"{% elif cell.label %} class="label"{% endif %}>{{ cell.text }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
{% endif %}
{% endfor %}
</section>
{% endfor %}
</div>
</body>
</html>
